<style id="wp-custom-css">
body {
	background-color: #0B0D15;
}
#content .page-header {
	display: none;
}
body a {
	text-decoration: none !important;
}
.dwqa-staff, .dwqa-question-filter{
	visibility: hidden;
	display: none;
}
main#content{
	max-width: 100%;
}
.dwqa-single-question {
	max-width: 1160px;
	margin: 0 auto;
	padding: 72px 20px 0px 20px;
}
.dwqa-single-question p, .dwqa-single-question span {
	color: #fff !important;
}
#dwqa-search input {
border: 1px solid #D5F2FC;
color: #fff;
border-radius: 2px;
background-color: #0C0F17 !important;
}
#question-title {
	border: 1px solid #464B58;
border-radius: 5x !important;
background-color: #0C0F17 !important;
color: #fff;
}
#question-status {
	border: 1px solid #464B58 !important;
border-radius: 5x !important;
background-color: #0C0F17  !important;
padding: .5rem 1rem;
color: #fff;
}
#question-category {
	border: 1px solid #464B58;
border-radius: 5x !important;
background-color: #0C0F17   !important;
color: #fff;
}
