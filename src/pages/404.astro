---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = new URL('/404/', Astro.site).href;
---

<BaseLayout
  title="Seite nicht gefunden - AdultVragen.de"
  description="Die angeforderte Seite konnte nicht gefunden werden."
  canonicalUrl={canonicalUrl}
>
  <Header />
  <main id="content" class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__brand">AdultVragen.de</p>
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 class="not-found__title">Seite nicht gefunden</h1>
      <p class="not-found__text">
        Die Seite, die Sie suchen, existiert nicht oder wurde verschoben. Nutzen Sie die Navigation
        oder kehren Sie zur Startseite zurück.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn--primary">Zur Startseite</a>
        <a href="/blog/" class="btn btn--outline">Zum Blog</a>
        <a href="/sitemap/" class="btn btn--outline">Sitemap</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: min(70vh, 640px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .not-found::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(225, 6, 0, 0.16), transparent 50%),
      radial-gradient(ellipse at 90% 100%, rgba(196, 168, 138, 0.06), transparent 40%);
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .not-found__brand {
    margin: 0 0 0.75rem;
    font-family: var(--font-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .not-found__code {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: rgba(244, 242, 239, 0.08);
  }

  .not-found__title {
    margin: -1.5rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .not-found__title::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 1rem;
    background: linear-gradient(90deg, var(--color-primary), rgba(225, 6, 0, 0.2));
    border-radius: 999px;
  }

  .not-found__text {
    margin: 0 0 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 34rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
