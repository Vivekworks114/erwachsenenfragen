---
import { getCollection, render } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageContentLayout from '../layouts/PageContentLayout.astro';
import ProductReviewLayout from '../layouts/ProductReviewLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const staticPageSlugs = new Set([
    'fragen-anzeigen',
    'fragen-stellen',
    'kontakt',
    'uber-uns',
    'anmeldung',
    'impressum',
    'sitemap',
    'blog',
  ]);

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries
    .filter((entry) => !staticPageSlugs.has(entry.id))
    .map((entry) => {
      const pageType =
        entry.data.pageType ||
        (entry.id.startsWith('beste-') ? 'review' : 'page');
      return {
        params: { slug: entry.id },
        props: { type: pageType as 'page' | 'review', entry },
      };
    });

  return [...blogPaths, ...pagePaths];
}

const { entry, type } = Astro.props;
const { Content } = await render(entry);
---

{
  type === 'blog' ? (
    <BlogPostLayout entry={entry}>
      <Header slot="header" />
      <Content />
      <Footer slot="footer" />
    </BlogPostLayout>
  ) : type === 'review' ? (
    <ProductReviewLayout entry={entry}>
      <Header slot="header" />
      <Content />
      <Footer slot="footer" />
    </ProductReviewLayout>
  ) : (
    <PageContentLayout entry={entry}>
      <Header slot="header" />
      <Content />
      <Footer slot="footer" />
    </PageContentLayout>
  )
}
