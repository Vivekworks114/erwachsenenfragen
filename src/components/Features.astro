---
interface Props {
  title: string;
  description?: string;
  centered?: boolean;
}

const { title, description, centered = true } = Astro.props;
---

<section class="section section--surface features">
  <div class="container">
    <h2 class:list={['section-title', !centered && 'section-title--left']}>{title}</h2>
    {description && <p class="section-subtitle">{description}</p>}
    <slot />
  </div>
</section>

<style>
  .features {
    position: relative;
  }

  .features::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-secondary);
    opacity: 0.07;
    pointer-events: none;
  }

  .section-title--left {
    text-align: left;
  }
</style>
