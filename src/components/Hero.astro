---

<section class="hero">
  <div class="hero__bg">
    <img
      src="/images/hero/rectangle-6.jpg"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      class="hero__bg-image"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <div class="hero__text">
      <h1 class="hero__title">Fragen für das Schlafzimmer</h1>
      <p class="hero__subtitle">Die Website für alle Fragen zum Thema Sex.</p>
      <a href="/fragen-stellen" class="btn btn--outline hero__cta">Eine Frage stellen</a>
    </div>
  </div>

  <div class="container hero__categories">
    <div class="category-grid">
      {
        categories.map((category) => (
          <a href={category.href} class="category-card" style={`--card-bg: url('${category.image}')`}>
            <span class="category-card__icon" set:html={icons[category.icon]} />
            <h3 class="category-card__title">{category.title}</h3>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -72px;
    padding-top: calc(72px + clamp(8rem, 18vw, 14.5rem));
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg);
    opacity: 0.72;
  }

  .hero__content,
  .hero__categories {
    position: relative;
    z-index: 1;
  }

  .hero__text {
    max-width: 640px;
    padding-bottom: clamp(3rem, 10vw, 8rem);
  }

  .hero__title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .hero__subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .hero__cta {
    margin-top: 1rem;
  }

  .hero__categories {
    margin-top: clamp(-8rem, -12vw, -11.5rem);
    position: relative;
    z-index: 2;
    padding-bottom: 3.875rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    min-height: 120px;
    padding: 0.625rem 1.5rem;
    border-radius: var(--card-radius);
    background-image: var(--card-bg);
    background-size: cover;
    background-position: center;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    color: var(--color-secondary);
  }

  .category-card__icon {
    display: flex;
    line-height: 0;
  }

  .category-card__icon :global(svg) {
    width: 48px;
    height: 48px;
  }

  .category-card__title {
    font-family: var(--font-accent);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  @media (max-width: 1023px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__categories {
      margin-top: -7.5rem;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-bottom: clamp(18rem, 50vw, 30rem);
    }

    .hero__categories {
      margin-top: -26rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.625rem;
    }

    .category-card {
      min-height: 100px;
      padding: 0.625rem 1rem;
    }
  }
</style>
