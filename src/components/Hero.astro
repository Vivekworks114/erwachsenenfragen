---
import { categories } from '../data/products';
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/hero/rectangle-6.jpg"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      class="hero__bg-image"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__body">
    <div class="hero__text">
      <h1 class="hero__title">Fragen für das Schlafzimmer</h1>
      <p class="hero__subtitle">Die Website für alle Fragen zum Thema Sex.</p>
      <a href="/fragen-stellen/" class="btn btn--outline hero__cta">Eine Frage stellen</a>
    </div>
  </div>

  <div class="container hero__categories">
    <div class="category-grid">
      {
        categories.map((category) => (
          <a
            href={category.href}
            class="category-card"
            style={`--card-bg: url('${category.image}')`}
          >
            <img
              class="category-card__icon"
              src={category.icon}
              alt=""
              width="48"
              height="48"
              loading="lazy"
            />
            <span class="category-card__title">{category.title}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -72px;
    padding-top: calc(72px + 9rem);
    padding-bottom: 20rem;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: #0b0d15;
    opacity: 0.72;
  }

  .hero__body {
    position: relative;
    z-index: 1;
  }

  .hero__text {
    max-width: 50%;
    padding-right: 1.5rem;
  }

  .hero__title {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-secondary);
    margin: 0 0 0.75rem;
  }

  .hero__subtitle {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-secondary);
    margin: 0;
  }

  .hero__cta {
    margin-top: 1rem;
    padding: 0.8125rem 1.75rem;
    border-radius: var(--card-radius);
  }

  .hero__categories {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3.875rem;
    z-index: 2;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    min-height: 100px;
    margin: 10px;
    padding: 10px 24px;
    border-radius: var(--card-radius);
    background-image: var(--card-bg);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .category-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 13, 21, 0.35) 0%, rgba(11, 13, 21, 0.72) 100%);
    transition: opacity var(--transition);
  }

  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    color: var(--color-secondary);
  }

  .category-card:hover::before {
    opacity: 0.85;
  }

  .category-card__icon,
  .category-card__title {
    position: relative;
    z-index: 1;
  }

  .category-card__icon {
    display: block;
    width: 48px;
    height: 48px;
    margin-bottom: 0;
  }

  .category-card__title {
    font-family: var(--font-accent);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-secondary);
  }

  @media (max-width: 1023px) {
    .hero {
      padding-top: calc(72px + 3.25rem);
      padding-bottom: 14rem;
    }

    .hero__text {
      max-width: 70%;
    }

    .hero__title {
      font-size: 3rem;
    }

    .hero__categories {
      bottom: 2.625rem;
    }

    .category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: calc(64px + 3.75rem);
      padding-bottom: 30rem;
    }

    .hero__text {
      max-width: 100%;
      padding-right: 0;
    }

    .hero__title {
      font-size: 2.25rem;
    }

    .hero__subtitle {
      font-size: 1.25rem;
    }

    .hero__categories {
      bottom: 1.5rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-card {
      margin: 6px;
      padding: 10px 16px;
      min-height: 96px;
    }
  }
</style>
