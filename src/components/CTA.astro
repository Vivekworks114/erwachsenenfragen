---
interface Props {
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  backgroundImage: string;
  variant?: 'outline' | 'filled';
}

const {
  title,
  subtitle,
  buttonText,
  buttonHref = '/fragen-stellen',
  backgroundImage,
  variant = 'outline',
} = Astro.props;
---

<section class="cta" style={`--cta-bg: url('${backgroundImage}')`}>
  <div class="cta__overlay"></div>
  <div class="container cta__inner">
    <div class="cta__content">
      <h2 class="cta__title">{title}</h2>
      {subtitle && <p class="cta__subtitle">{subtitle}</p>}
      {
        buttonText && (
          <a
            href={buttonHref}
            class:list={['btn', variant === 'filled' ? 'btn--filled-white' : 'btn--outline', 'cta__btn']}
          >
            {buttonText}
          </a>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--section-padding);
    background-image: var(--cta-bg);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .cta__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg);
    opacity: 0.72;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
  }

  .cta__content {
    max-width: 55%;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-radius: var(--card-radius-lg);
    background: rgba(11, 13, 21, 0.35);
    backdrop-filter: blur(4px);
  }

  .cta__title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .cta__subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .cta__btn {
    margin-top: 1rem;
  }

  @media (max-width: 767px) {
    .cta__content {
      max-width: 100%;
    }
  }
</style>
