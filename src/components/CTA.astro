---
interface Props {
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  backgroundImage: string;
  variant?: 'outline' | 'filled';
}

const {
  title,
  subtitle,
  buttonText,
  buttonHref = '/fragen-stellen/',
  backgroundImage,
  variant = 'outline',
} = Astro.props;
---

<section class="cta" style={`--cta-bg: url('${backgroundImage}')`}>
  <div class="cta__overlay"></div>
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="container cta__inner">
    <div class="cta__content">
      <h2 class="cta__title">{title}</h2>
      {subtitle && <p class="cta__subtitle">{subtitle}</p>}
      {
        buttonText && (
          <a
            href={buttonHref}
            class:list={['btn', variant === 'filled' ? 'btn--filled-white' : 'btn--outline', 'cta__btn']}
          >
            {buttonText}
          </a>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--section-padding);
    background-image: var(--cta-bg);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .cta__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(8, 9, 14, 0.9) 0%, rgba(8, 9, 14, 0.72) 55%, rgba(8, 9, 14, 0.5) 100%);
  }

  .cta__glow {
    position: absolute;
    inset: auto 0 0;
    height: 50%;
    background: radial-gradient(ellipse at 20% 100%, rgba(225, 6, 0, 0.25), transparent 60%);
    pointer-events: none;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
  }

  .cta__content {
    max-width: 36rem;
  }

  .cta__title {
    font-size: clamp(2rem, 5vw, 3.15rem);
    letter-spacing: -0.03em;
    color: var(--color-secondary);
    margin-bottom: 0.85rem;
  }

  .cta__subtitle {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 400;
    color: rgba(244, 242, 239, 0.82);
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .cta__btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 767px) {
    .cta__content {
      max-width: 100%;
    }
  }
</style>
