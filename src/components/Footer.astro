---
import { getCollection } from 'astro:content';
import {
  footerInfoLinks,
  footerElectronicsLinks,
  footerBodyCareLinks,
  footerAirLinks,
} from '../data/navigation';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" aria-label="AdultVragen.de Startseite">
        <img src="/images/brand/logo.svg" alt="AdultVragen.de" width="257" height="29" />
      </a>
      <p class="footer__description">
        AdultVragen.de ist die Website für alle Erwachsenen, die Fragen zum Sexualleben haben.
        Hier können Sie Fragen stellen und Fragen anderer Nutzer beantworten. Außerdem schreiben
        unsere Redakteure jede Woche neue Blogs in verschiedenen Kategorien, und Sie können nach
        den besten Produkten für das Schlafzimmer suchen.
      </p>
      <p class="footer__links-inline">
        <strong><a href="/sitemap/">Sitemap</a></strong>
      </p>
      <p class="footer__links-inline">
        <a href="/impressum/" target="_blank" rel="noopener">Impressum</a>
      </p>
      <div class="footer__social" aria-label="Soziale Medien">
        <a href="#" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Twitter" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Youtube" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
      <p class="footer__copyright">© 2026 Alle Rechte vorbehalten</p>
    </div>

    <div class="footer__column">
      <h4 class="footer__heading">Informationen</h4>
      <ul class="footer__list">
        {footerInfoLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__column">
      <h4 class="footer__heading">Neueste Blogs</h4>
      <ul class="footer__list footer__list--blogs">
        {blogPosts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer__column">
      <h4 class="footer__heading">Elektronische Geräte</h4>
      <ul class="footer__list">
        {footerElectronicsLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__column">
      <h4 class="footer__heading">Körperpflege</h4>
      <ul class="footer__list">
        {footerBodyCareLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__column">
      <h4 class="footer__heading">Luftaufbereitung</h4>
      <p class="footer__air-links">
        {
          footerAirLinks.map((link, index) => (
            <>
              {index > 0 && <br />}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    border-top: 1px solid rgba(70, 75, 88, 0.35);
    padding-block: clamp(2.25rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.75rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: 2rem 1.5rem;
  }

  .footer__brand img {
    width: 257px;
    max-width: 100%;
    margin-bottom: 1.25rem;
  }

  .footer__description {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text);
    max-width: 326px;
    margin-bottom: 1rem;
  }

  .footer__links-inline {
    font-size: 14px;
    margin-bottom: 0.5rem;
  }

  .footer__links-inline a:hover {
    color: var(--color-primary);
  }

  .footer__social {
    display: flex;
    gap: 1rem;
    margin: 1.25rem 0;
  }

  .footer__social-link {
    display: flex;
    color: var(--color-primary);
    transition: opacity var(--transition), transform var(--transition);
  }

  .footer__social-link:hover {
    opacity: 0.8;
    transform: translateY(-2px);
    color: var(--color-primary);
  }

  .footer__copyright {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer__heading {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
    display: inline-block;
  }

  .footer__list a {
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text);
    transition: color var(--transition), padding-left var(--transition);
  }

  .footer__list a:hover {
    color: var(--color-primary);
    padding-left: 0.25rem;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .footer__list--blogs a {
    line-height: 1.4;
    font-weight: 700;
    padding-block: 0.25rem;
  }

  .footer__air-links {
    font-size: 14px;
    line-height: 2;
    margin: 0;
  }

  .footer__air-links a {
    color: var(--color-text);
    transition: color var(--transition);
  }

  .footer__air-links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 1023px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1rem;
    }
  }

  @media (max-width: 479px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
