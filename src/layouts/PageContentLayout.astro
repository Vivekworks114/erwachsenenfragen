---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { getContentHtml, hasContentTitle } from '../lib/content-html';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { title, description } = entry.data;
const contentHtml = getContentHtml(entry);
const showHero = !hasContentTitle(entry);
---

<BaseLayout
  title={`${title} - AdultVragen.de`}
  description={description || title}
>
  <slot name="header" />
  <main id="content">
    {
      showHero && (
        <section class="page-hero section--surface">
          <div class="container">
            <h1 class="page-hero__title">{title}</h1>
            {description && <p class="page-hero__subtitle">{description}</p>}
          </div>
        </section>
      )
    }
    <section class="section">
      <div class="container page-content prose">
        {
          contentHtml ? (
            <div class="wp-content" set:html={contentHtml} />
          ) : (
            <slot />
          )
        }
      </div>
    </section>
  </main>
  <slot name="footer" />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 6rem) clamp(2.25rem, 5vw, 3.25rem);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(225, 6, 0, 0.16), transparent 50%),
      linear-gradient(180deg, rgba(14, 17, 25, 0.65) 0%, transparent 100%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero__title {
    font-size: clamp(2.15rem, 5.5vw, 3.35rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.85rem;
  }

  .page-hero__title::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 1rem;
    background: linear-gradient(90deg, var(--color-primary), rgba(225, 6, 0, 0.2));
    border-radius: 999px;
  }

  .page-hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.55;
  }

  .page-content {
    max-width: 800px;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(244, 242, 239, 0.9);
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }

  .page-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .page-content :global(a) {
    color: var(--color-primary);
  }

  .page-content :global(h2),
  .page-content :global(h3) {
    font-family: var(--font-heading);
    margin: 2rem 0 1rem;
    letter-spacing: -0.02em;
  }
</style>
