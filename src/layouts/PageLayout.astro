---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  intro?: string;
}

const { title, description, heading, intro } = Astro.props;
---

<BaseLayout {title} {description}>
  <Header />
  <main id="content">
    <section class="page-hero section--surface">
      <div class="container">
        <h1 class="page-hero__title">{heading}</h1>
        {intro && <p class="page-hero__subtitle">{intro}</p>}
      </div>
    </section>
    <section class="section">
      <div class="container page-content">
        <slot />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .page-hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.5;
  }

  .page-content {
    max-width: 800px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .page-content :global(p) {
    margin-bottom: 1.25rem;
  }
</style>
