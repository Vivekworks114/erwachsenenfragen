---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, author, categories, image, imageAlt } =
  entry.data;

const formattedDate = pubDate.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - AdultVragen.de`} description={description}>
  <slot name="header" />
  <main id="content">
    <article class="blog-detail">
      {
        image && (
          <div class="blog-detail__hero">
            <img
              src={image}
              alt={imageAlt || title}
              width={1200}
              height={675}
              loading="eager"
              fetchpriority="high"
              class="blog-detail__image"
            />
            <div class="blog-detail__hero-overlay" />
          </div>
        )
      }

      <div class="container blog-detail__content">
        <header class="blog-detail__header">
          <p class="blog-detail__meta">
            {
              categories && categories.length > 0 && (
                <span class="blog-detail__category">{categories.join(', ')}</span>
              )
            }
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {author && <span class="blog-detail__author">{author}</span>}
          </p>
          <h1 class="blog-detail__title">{title}</h1>
          {description && <p class="blog-detail__excerpt">{description}</p>}
          {
            updatedDate && (
              <p class="blog-detail__updated">
                Aktualisiert: <time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
              </p>
            )
          }
        </header>

        <div class="blog-detail__body prose">
          {
            entry.data.contentHtml ? (
              <div class="wp-content" set:html={entry.data.contentHtml} />
            ) : (
              <slot />
            )
          }
        </div>

        <footer class="blog-detail__footer">
          <a href="/blog" class="btn btn--outline">← Zurück zum Blog</a>
        </footer>
      </div>
    </article>
  </main>
  <slot name="footer" />
</BaseLayout>

<style>
  .blog-detail__hero {
    position: relative;
    max-height: 480px;
    overflow: hidden;
  }

  .blog-detail__image {
    width: 100%;
    height: clamp(240px, 40vw, 480px);
    object-fit: cover;
  }

  .blog-detail__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-bg) 0%, transparent 60%);
  }

  .blog-detail__content {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem);
    max-width: 800px;
  }

  .blog-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .blog-detail__category {
    color: var(--color-primary);
    font-weight: 700;
  }

  .blog-detail__author {
    color: var(--color-text-muted);
  }

  .blog-detail__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .blog-detail__excerpt {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .blog-detail__updated {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .blog-detail__body :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .blog-detail__body :global(h2),
  .blog-detail__body :global(h3),
  .blog-detail__body :global(h4) {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    margin: 2rem 0 1rem;
    line-height: 1.3;
  }

  .blog-detail__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-detail__body :global(img) {
    border-radius: var(--card-radius);
    margin: 1.5rem 0;
  }

  .blog-detail__footer {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
