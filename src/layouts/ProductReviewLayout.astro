---
import type { CollectionEntry } from 'astro:content';
import type { CatalogProduct } from '../lib/catalog';
import BaseLayout from './BaseLayout.astro';
import ProductReviewContent from '../components/ProductReviewContent.astro';
import { getContentHtml } from '../lib/content-html';

interface Props {
  entry: CollectionEntry<'pages'>;
  product?: CatalogProduct;
}

const { entry, product } = Astro.props;
const { title, description } = entry.data;
const contentHtml = product ? '' : getContentHtml(entry);
---

<BaseLayout title={`${title} - AdultVragen.de`} description={description || title}>
  <slot name="header" />
  <main id="content" class="product-review">
    <section class="section product-review__section">
      <div class="container product-review__container">
        {
          product ? (
            <ProductReviewContent product={product} />
          ) : contentHtml ? (
            <div class="wp-content product-review__body" set:html={contentHtml} />
          ) : (
            <div class="wp-content product-review__body">
              <slot />
            </div>
          )
        }
      </div>
    </section>
  </main>
  <slot name="footer" />
</BaseLayout>

<style>
  .product-review__section {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .product-review__container {
    max-width: 960px;
  }
</style>
